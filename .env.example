# Copy this file to .env only if your local workflow needs it.
# ForgeAgent will not read .env files from a target workspace by default.

FORGE_MODEL_PROVIDER=openai
FORGE_MODEL_API_KEY=replace-with-your-api-key
FORGE_MODEL_BASE_URL=https://example.com/v1
FORGE_MODEL_NAME=replace-with-your-model-name
FORGE_MODEL_INPUT_COST_PER_MILLION=
FORGE_MODEL_OUTPUT_COST_PER_MILLION=
FORGE_MODEL_CACHED_INPUT_COST_PER_MILLION=
FORGE_AGENT_MAX_COST_USD=1.00
FORGE_AGENT_MAX_REPEATED_FAILURES=3
FORGE_COMMANDS_APPROVAL=risky
FORGE_PATCHES_APPROVAL=always
FORGE_EXECUTION_BACKEND=auto
FORGE_DOCKER_IMAGE=forge-agent:dev
FORGE_CONTEXT_MAX_TOKENS=32000
FORGE_CONTEXT_RESERVE_TOKENS=8192
FORGE_CONTEXT_KEEP_RECENT_TOKENS=12000
FORGE_CONTEXT_MAX_TOOL_RESULT_CHARS=2000
FORGE_COMPACTION_ENABLED=true
FORGE_RLM_MAX_DEPTH=1
FORGE_RLM_MAX_CONCURRENT_CHILDREN=4
FORGE_RLM_CHILD_OVERFLOW=reject
FORGE_RLM_HOST_REQUEST_TIMEOUT_SECONDS=10
