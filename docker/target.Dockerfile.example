# Build context: the target repository, prepared with requirements.lock and wheels/.
FROM forge-agent:dev

USER root
COPY requirements.lock /tmp/target/requirements.lock
COPY wheels /tmp/target/wheels
RUN python -m pip install \
    --no-cache-dir \
    --no-index \
    --find-links=/tmp/target/wheels \
    --requirement /tmp/target/requirements.lock \
    && rm -rf /tmp/target
USER 10001:10001
